[Unit]
Description=Unofficial Betaflight uConsole static web server
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/betaflight-uconsole/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077

[Install]
WantedBy=default.target
